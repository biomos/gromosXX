#!/usr/bin/env bash
#
# Wrapper around asv.
#
# asv is installed with "pip install --target" into a directory of its own
# rather than into the system or user site-packages, so it needs PYTHONPATH set
# and is not on PATH. This wrapper supplies both, and cds to its own directory
# so that asv picks up the asv.conf.json sitting next to it.
#
# (asv itself chdirs to the directory holding the config file and resolves
# repo, benchmark_dir and the {conf_dir} used by the build hooks relative to
# that -- so a config kept anywhere else needs absolute paths for all three.)
#
# Usage: ./asv show | ./asv run HEAD^! | ./asv publish ...
#
# Set GROMOS_ASV_TOOLS to point at a different asv installation.

set -euo pipefail

TOOLS="${GROMOS_ASV_TOOLS:-/local/gromos/bench_tools}"

if [ ! -x "${TOOLS}/bin/asv" ]; then
    echo "asv not found at ${TOOLS}/bin/asv" >&2
    echo "Install it with:" >&2
    echo "  python3 -m pip install --target ${TOOLS} asv virtualenv" >&2
    exit 1
fi

cd "$(dirname "$(readlink -f "$0")")"

export PYTHONPATH="${TOOLS}${PYTHONPATH:+:${PYTHONPATH}}"

# Drop asv's spurious mamba plugin warning. asv means to ignore a missing
# mamba, but its guard tests for ".mamba" in the module name while the module
# is actually called "_mamba_helpers", so the underscore defeats the match and
# it logs an error on every invocation. Nothing here uses mamba -- the
# environments are virtualenvs. Matched as exact whole lines so that any other
# diagnostic still reaches the terminal, and asv's exit status is preserved.
"${TOOLS}/bin/asv" "$@" 2> >(grep -vFx \
    -e "Couldn't load asv.plugins._mamba_helpers because" \
    -e "No module named 'libmambapy'" >&2)
status=$?
wait
exit "${status}"
